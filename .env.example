# Copy to .env and fill in ONE of these (from https://www.themoviedb.org/settings/api).
# The v4 read access token is preferred; the v3 API key also works.
TMDB_READ_TOKEN=
TMDB_API_KEY=

# Optional Kaggle API credentials (the TMDB 5000 dataset is public and downloads without them)
# (kaggle.com -> Settings -> API -> Create New Token).
KAGGLE_USERNAME=
KAGGLE_KEY=
